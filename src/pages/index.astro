---
import Layout from '../layouts/base.astro'
import Header from '../components/header.astro'
import { getEnv } from '../lib/env'
import { getSingleChannelInfo } from '../lib/telegram'

// 读取频道配置
const channelsStr = getEnv(import.meta.env, Astro, 'CHANNELS') || getEnv(import.meta.env, Astro, 'CHANNEL')
const channels = channelsStr ? channelsStr.split(',').map(c => c.trim()).filter(Boolean) : []

// 没有配置频道,返回404
if (channels.length === 0) {
  return Astro.redirect('/404')
}

const { SITE_URL, SITE_NAME, SITE_AVATAR } = Astro.locals

// 并发获取每个频道的基本信息(昵称/头像)以便展示卡片
const channelInfos = await Promise.all(channels.map(async (ch) => {
  try {
    const info = await getSingleChannelInfo(Astro, ch, {})
    return {
      username: ch,
      title: info.title || ch,
      avatar: info.avatar || '',
      avatarFallback: info.avatarFallback || null
    }
  } catch (e) {
    // 获取失败时使用备用数据
    return {
      username: ch,
      title: ch,
      avatar: '',
      avatarFallback: null
    }
  }
}))

const siteHeader = {
  title: SITE_NAME || 'Multi-Channel Broadcast',
  avatar: SITE_AVATAR || null
}

---

<Layout channel={siteHeader} currentChannel={null}>
  <Header channel={siteHeader} showGlobalRss={true} rssUrl={`${SITE_URL}rss.xml`} />

  <main class="home-channels">
    <h2 class="home-title">频道列表</h2>
    <div class="channel-grid">
      {channelInfos.map((info) => (
        <a class="channel-card" href={`${SITE_URL}channel/${info.username}`} title={info.title}>
          <div class="avatar-wrap" aria-hidden="true">
            {info.avatar ? (
              <img
                src={info.avatar}
                alt={info.title}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                onerror={info.avatarFallback?.wsrv ? `this.onerror=function(){this.onerror=null;this.src='${info.avatarFallback.original}'};this.src='${info.avatarFallback.wsrv}';` : undefined}
              />
            ) : (
              <div class="avatar-fallback">{(info.title || info.username).slice(0, 1).toUpperCase()}</div>
            )}
          </div>
          <div class="card-body">
            <div class="card-title">{info.title}</div>
            <div class="card-username">@{info.username}</div>
          </div>
        </a>
      ))}
    </div>
  </main>

</Layout>

<style>
  .home-channels {
    max-width: 1160px;
    margin: 0 auto;
    padding: 4px 20px 0;
  }

  .home-title {
    font-size: 18px;
    margin: 0 0 14px;
    color: var(--text-color, #333);
  }

  .channel-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .channel-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 13px;
    border-radius: 7px;
    text-decoration: none;
    color: inherit;
    background: var(--card-bg, #fff);
    border: 1px solid var(--border-color, #e9e9e9);
    transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;
  }

  .channel-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong-color, #d0d0d0);
    box-shadow: 0 8px 20px rgba(56, 45, 33, 0.08);
  }

  .channel-card:focus-visible {
    outline: 3px solid rgba(217, 93, 57, 0.28);
    outline-offset: 3px;
    border-color: var(--highlight-color, #d95d39);
  }

  .avatar-wrap {
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    border-radius: 7px;
    overflow: hidden;
    background: var(--avatar-bg, #f5f5f5);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-fallback {
    font-weight: 600;
    color: var(--secondary-color, #666);
  }

  .card-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .card-title {
    overflow: hidden;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-color, #333);
  }

  .card-username {
    overflow: hidden;
    font-size: 13px;
    color: var(--secondary-color, #777);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .channel-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .home-channels {
      padding: 0 0 0;
    }

    .channel-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .channel-card {
      padding: 11px;
    }

    .avatar-wrap {
      width: 50px;
      height: 50px;
    }
  }
</style>
---
